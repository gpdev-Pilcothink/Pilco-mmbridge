# =============================================================================
# MM-Bridge server
# =============================================================================
# Use 127.0.0.1 when a reverse proxy runs on the same machine.
# Use 0.0.0.0 only when direct network access is required and protected.
MM_BRIDGE_HOST=127.0.0.1
MM_BRIDGE_PORT=18000

# Generate locally:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
MM_BRIDGE_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN

MM_BRIDGE_MODEL_ID=deepseek-v4-mm-bridge
# 1 = separate text model + multimodal analyzer
# 2 = multimodal main model; skip analyzer enrichment
MM_BRIDGE_MODE=1
MM_LOG_LEVEL=INFO

# =============================================================================
# Final text-model upstream
# =============================================================================
# Root URL only. Do not append /v1.
VLLM_ROOT_URL=http://127.0.0.1:8000
VLLM_API_KEY=EMPTY
VLLM_AUTH_STYLE=auto

# Leave empty to use the first model returned by GET /v1/models.
VLLM_MODEL=

# =============================================================================
# Vision-analyzer upstream
# =============================================================================
# LLAMA_* names are retained for compatibility.
# This may point to llama.cpp or a vision-capable vLLM server.
# Root URL only. Do not append /v1.
LLAMA_ROOT_URL=http://127.0.0.1:8001
LLAMA_API_KEY=EMPTY
LLAMA_AUTH_STYLE=auto

# Leave empty to use the first model returned by GET /v1/models.
LLAMA_MODEL=

# =============================================================================
# Analyzer and injection
# =============================================================================
MM_ANALYZER_ENDPOINTS=/v1/chat/completions,/v1/messages,/v1/responses
MM_ANALYZER_FORCE_STREAM_FALSE=true
MM_ANALYZER_RESPONSE_FORMAT_JSON=true

# Recommended minimum for complex OCR, game screens, code, terminal output,
# and multi-image requests. The model/server context limits must support it.
MM_ANALYZER_MAX_TOKENS=16384
MM_ANALYZER_TEMPERATURE=0

MM_ANALYZER_CACHE=true
MM_ANALYZER_CACHE_DIR=.cache/mm_bridge
MM_FAIL_ON_ANALYZER_ERROR=true

# =============================================================================
# Final text-model media behavior
# =============================================================================
# keep    = retain raw media
# replace = replace raw media with text placeholders; recommended for text-only models
# strip   = remove raw media
MM_VLLM_MEDIA_POLICY=replace

# passthrough = forward unsupported media endpoints without analyzer enrichment
# error       = stop with HTTP 501
MM_UNSUPPORTED_MEDIA_ENDPOINT_POLICY=error

# =============================================================================
# Model listing and rewrite
# =============================================================================
# alias_plus_upstream | alias_only | upstream_only | passthrough
MM_MODELS_POLICY=alias_only
MM_REWRITE_BRIDGE_MODEL_ONLY=true

# =============================================================================
# Limits and timeout
# =============================================================================
MM_MAX_BODY_BYTES=104857600
MM_MAX_MEDIA_BYTES=52428800
MM_MAX_MEDIA_ITEMS=8
MM_HTTP_TIMEOUT_SECONDS=600
# Idle connection reuse only; independent of the generation/read timeout.
# 0 disables idle connection reuse. Must be finite and non-negative.
MM_HTTP_KEEPALIVE_EXPIRY_SECONDS=2
MM_STREAM_HEARTBEAT_SECONDS=15

# =============================================================================
# Debugging
# =============================================================================
# Keep disabled in production. Debug files may contain prompts, media,
# model output, credentials, and internal URLs.
MM_DEBUG_DUMP=false
MM_DEBUG_DUMP_DIR=.debug/mm_bridge

# Keep disabled in production. Enabling this may expose upstream URLs and bodies.
MM_WRAP_UPSTREAM_ERRORS=false
